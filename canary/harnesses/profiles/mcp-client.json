{
  "id": "mcp-client",
  "name": "Generic MCP client host",
  "kind": "enterprise",
  "status": "approximate",
  "approximate": true,
  "summary": "Chat host that exposes tools from reference MCP servers (filesystem, fetch, git) with server-prefixed names; results are MCP content arrays.",
  "sources": [
    {
      "url": "https://modelcontextprotocol.io/specification/2025-11-25/server/tools",
      "licence": "spec",
      "what": "tools/list and tools/call shapes (name, arguments, content[], isError)",
      "fetched": "2026-10-28"
    },
    {
      "url": "https://github.com/modelcontextprotocol/servers",
      "licence": "MIT",
      "what": "reference servers filesystem, fetch, git",
      "fetched": "2026-10-28"
    }
  ],
  "excerpts": [],
  "verified_parts": [
    "tools/call request and result envelope"
  ],
  "approximate_parts": [
    "server tool names and argument shapes",
    "host system prompt",
    "task prompts"
  ],
  "tool_mode": "native",
  "os_hint": [
    "linux"
  ],
  "system": {
    "style": "host sentence",
    "length_class": "short",
    "template": "You are a helpful assistant with access to tools from connected MCP servers: filesystem (allowed directory <<cwd>>), fetch and git. Today is <<date>>."
  },
  "project_instructions": {
    "file": "AGENTS.md",
    "placement": "none"
  },
  "task_wrapper": "<<task>>",
  "preamble": [],
  "start_calls": [
    {
      "role": "list",
      "arguments": {
        "path": "<<cwd>>/<<doc_dir>>"
      }
    }
  ],
  "loop": {
    "result_wrapper": "{\"content\": [{\"type\": \"text\", \"text\": <<result>>}], \"isError\": false}"
  },
  "tools": [
    {
      "role": "read",
      "function": {
        "name": "filesystem__read_text_file",
        "description": "Read the complete contents of a file as text.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path of the file"
            },
            "head": {
              "type": "number"
            },
            "tail": {
              "type": "number"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "role": "write",
      "function": {
        "name": "filesystem__write_file",
        "description": "Create a new file or completely overwrite an existing file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path of the file"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ]
        }
      }
    },
    {
      "role": "edit",
      "function": {
        "name": "filesystem__edit_file",
        "description": "Make line-based edits to a text file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path of the file"
            },
            "edits": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "path",
            "edits"
          ]
        }
      }
    },
    {
      "role": "list",
      "function": {
        "name": "filesystem__list_directory",
        "description": "Get a detailed listing of all files and directories in a specified path.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path of the file"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "role": "grep",
      "function": {
        "name": "filesystem__search_files",
        "description": "Recursively search for files matching a pattern.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path of the file"
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "pattern"
          ]
        }
      }
    },
    {
      "role": "web_fetch",
      "function": {
        "name": "fetch__fetch",
        "description": "Fetches a URL from the internet and extracts its contents as markdown.",
        "parameters": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "max_length": {
              "type": "number"
            },
            "raw": {
              "type": "boolean"
            }
          },
          "required": [
            "url"
          ]
        }
      }
    },
    {
      "role": "shell",
      "function": {
        "name": "git__git_status",
        "description": "Shows the working tree status.",
        "parameters": {
          "type": "object",
          "properties": {
            "repo_path": {
              "type": "string"
            }
          },
          "required": [
            "repo_path"
          ]
        }
      }
    }
  ],
  "tasks": [
    {
      "id": "weekly-summary",
      "prompt": "Summarise the document <<doc_path>> for the weekly report in at most six lines.",
      "allows": [
        "read"
      ],
      "write_paths": []
    },
    {
      "id": "extract-actions",
      "prompt": "Extract the open action items from <<doc_path>> and list them with owner and due date where the text gives them.",
      "allows": [
        "read",
        "grep"
      ],
      "write_paths": []
    },
    {
      "id": "qa",
      "prompt": "A colleague asks: what does <<doc_name>> ask us to do next? Answer from the document only.",
      "allows": [
        "read",
        "grep"
      ],
      "write_paths": []
    }
  ]
}
