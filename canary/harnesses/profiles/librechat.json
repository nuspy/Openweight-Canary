{
  "id": "librechat",
  "name": "LibreChat agents",
  "kind": "enterprise",
  "status": "approximate",
  "approximate": true,
  "summary": "Agent with instructions, file search over uploads, web search, code interpreter and OpenAPI actions.",
  "sources": [
    {
      "url": "https://github.com/danny-avila/LibreChat",
      "licence": "MIT",
      "what": "api/app/clients/prompts, agents",
      "fetched": "2026-10-28"
    },
    {
      "url": "https://docs.librechat.ai/features/agents",
      "licence": "docs",
      "what": "agents documentation",
      "fetched": "2026-10-28"
    }
  ],
  "excerpts": [],
  "verified_parts": [
    "agent features: file_search, web_search, execute_code, actions"
  ],
  "approximate_parts": [
    "instruction wording",
    "tool argument shapes",
    "task prompts"
  ],
  "tool_mode": "native",
  "os_hint": [
    "linux"
  ],
  "system": {
    "style": "instructions block",
    "length_class": "short",
    "template": "Instructions:\nYou are the team's document assistant. Current date: <<date>>. Answer from the user's files when possible and cite the file name."
  },
  "project_instructions": {
    "file": "AGENTS.md",
    "placement": "none"
  },
  "task_wrapper": "<<task>>",
  "preamble": [],
  "start_calls": [],
  "loop": {
    "result_wrapper": "<<result>>"
  },
  "tools": [
    {
      "role": "grep",
      "function": {
        "name": "file_search",
        "description": "Search the user's uploaded files.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        }
      }
    },
    {
      "role": "read",
      "function": {
        "name": "read_uploaded_file",
        "description": "Read the full text of an uploaded file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path of the file"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "role": "web_search",
      "function": {
        "name": "web_search",
        "description": "Search the web.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        }
      }
    },
    {
      "role": "shell",
      "function": {
        "name": "execute_code",
        "description": "Run code in the sandboxed interpreter.",
        "parameters": {
          "type": "object",
          "properties": {
            "lang": {
              "type": "string"
            },
            "code": {
              "type": "string"
            }
          },
          "required": [
            "lang",
            "code"
          ]
        }
      }
    },
    {
      "role": "web_fetch",
      "function": {
        "name": "action_fetch_url",
        "description": "OpenAPI action: fetch a URL.",
        "parameters": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        }
      }
    }
  ],
  "tasks": [
    {
      "id": "weekly-summary",
      "prompt": "Summarise the document <<doc_path>> for the weekly report in at most six lines.",
      "allows": [
        "read"
      ],
      "write_paths": []
    },
    {
      "id": "extract-actions",
      "prompt": "Extract the open action items from <<doc_path>> and list them with owner and due date where the text gives them.",
      "allows": [
        "read",
        "grep"
      ],
      "write_paths": []
    },
    {
      "id": "qa",
      "prompt": "A colleague asks: what does <<doc_name>> ask us to do next? Answer from the document only.",
      "allows": [
        "read",
        "grep"
      ],
      "write_paths": []
    }
  ]
}
